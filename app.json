{
  "name": "django-react-webapp-template",
  "description": "Starter template for Django REST + React on Heroku",
  "repository": "https://github.com/your-org/your-template-repo",
  "keywords": ["python", "django", "react", "template"],
  "env": {
    "DJANGO_SECRET_KEY": {
      "description": "Secret key used by Django.",
      "generator": "secret"
    },
    "DJANGO_DEBUG": {
      "description": "Set to 0 in production.",
      "value": "0"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": ["heroku-postgresql:mini"],
  "environments": {
    "test": {
      "scripts": {
        "test": "python backend/manage.py test"
      }
    }
  }
}
